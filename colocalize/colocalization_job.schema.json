{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://johnsonlab.wilmer.jhu.edu/schemas/colocalization-job.schema.json",
  "title": "Johnson Lab colocalization job",
  "description": "Complete user-submittable request for source resolution, Cellpose segmentation, colocalization measurement, and workbook output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources", "analysis"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "experiment:ID, item:ID, upload:ID, eLabFTW URL, local file/directory/glob, or @manifest pointer."
      }
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspect": {"type": "boolean", "default": false},
        "save_segmentation": {"type": "boolean", "default": true}
      }
    }
  },
  "$defs": {
    "channel": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "title": "Zero-based index"},
        {"type": "string", "minLength": 1, "title": "Metadata channel name"}
      ]
    },
    "reference_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "channel", "model"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "channel": {"$ref": "#/$defs/channel"},
        "model": {"type": "string", "minLength": 1, "default": "cpdino_BRN3A"},
        "diameter": {"type": ["number", "null"], "exclusiveMinimum": 0, "default": null},
        "flow_threshold": {"type": "number", "default": 0.4},
        "cellprob_threshold": {"type": "number", "default": 0.0},
        "min_size": {"type": "integer", "minimum": 0, "default": 15},
        "normalize": {"type": "boolean", "default": true}
      }
    },
    "tissue_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "channel"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "channel": {"$ref": "#/$defs/channel"},
        "threshold": {"type": ["number", "null"], "default": null},
        "min_object_px": {"type": "integer", "minimum": 1, "default": 5000},
        "min_hole_px": {"type": "integer", "minimum": 1, "default": 5000},
        "fill_holes": {"type": "boolean", "default": false}
      }
    },
    "signal_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "channel"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "channel": {"$ref": "#/$defs/channel"},
        "threshold_method": {
          "type": "string",
          "enum": ["otsu", "percentile", "absolute", "percent_of_max", "none"],
          "default": "otsu"
        },
        "threshold_value": {"type": ["number", "null"], "default": null},
        "positive_fraction_cutoff": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.8},
        "background_method": {"type": "string", "enum": ["none", "fixed", "median", "percentile", "tissue_filtered_oop"], "default": "none"},
        "background_percentile": {"type": "number", "minimum": 0, "maximum": 100, "default": 50.0},
        "tissue_channel": {"oneOf": [{"$ref": "#/$defs/channel"}, {"type": "null"}], "default": null},
        "background_buffer_px": {"type": "integer", "minimum": 0, "default": 3},
        "background_anchor_percentile": {"type": "number", "minimum": 0, "maximum": 100, "default": 15.0},
        "background_fixed_value": {"type": ["number", "null"], "default": null},
        "background_dapi_threshold": {"type": "number", "default": 1.0},
        "debris_percentile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100, "default": 96.0},
        "debris_min_area_cell_sd": {"type": "number", "minimum": 0, "default": 5.0},
        "debris_buffer_px": {"type": "integer", "minimum": 0, "default": 0},
        "debris_thresh_property": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          ],
          "default": "area"
        },
        "prop_percentile_thresh": {"type": "number", "minimum": 0, "maximum": 100, "default": 50.0},
        "noise_normalize": {"type": "boolean", "default": false},
        "asinh_scale": {"type": ["number", "null"], "exclusiveMinimum": 0, "default": null},
        "quantiles": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}, "default": [0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99]},
        "tail_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.1},
        "noise_thresholds": {"type": "array", "items": {"type": "number", "minimum": 0}, "default": [3.0]}
      },
      "allOf": [
        {
          "if": {"properties": {"threshold_method": {"const": "absolute"}}, "required": ["threshold_method"]},
          "then": {"required": ["threshold_value"], "properties": {"threshold_value": {"type": "number"}}}
        },
        {
          "if": {"properties": {"background_method": {"const": "fixed"}}, "required": ["background_method"]},
          "then": {"required": ["background_fixed_value"], "properties": {"background_fixed_value": {"type": "number"}}}
        }
      ]
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_dir", "reference_sets", "signal_channels"],
      "properties": {
        "input_dir": {
          "type": "string",
          "default": ".",
          "description": "Legacy local-run field; source pointers replace it in interface jobs."
        },
        "output_dir": {"type": "string", "minLength": 1, "default": "results"},
        "reference_sets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference_set"}
        },
        "signal_channels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/signal_channel"}
        },
        "tissue_channel": {"oneOf": [{"$ref": "#/$defs/tissue_channel"}, {"type": "null"}], "default": null},
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\."},
          "default": [".oir", ".czi", ".tif", ".tiff", ".ome.tif", ".ome.tiff"]
        },
        "recursive": {"type": "boolean", "default": false},
        "exclude": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "time_index": {"type": "integer", "minimum": 0, "default": 0},
        "scene_index": {"type": "integer", "minimum": 0, "default": 0},
        "z_projection": {"type": "string", "enum": ["max", "mean", "first"], "default": "max"},
        "device": {
          "type": "string",
          "pattern": "^(auto|cpu|mps|cuda(:[0-9]+)?)$",
          "default": "auto"
        },
        "save_masks": {"type": "boolean", "default": true},
        "promote_2d_to_3d": {
          "type": "boolean",
          "default": false,
          "description": "Broadcast 2D channel images across Z when loaded masks are 3D and share YX dimensions."
        }
      }
    }
  }
}
